{
  "manifestVersion": 5,
  "id": "com.snailjoss.pssezhao",
  "name": "PS 去色罩",
  "version": "0.3.2",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0"
  },
  "apiVersion": 2,
  "entrypoints": [
    {
      "type": "panel",
      "id": "sezhaoPanel",
      "label": {
        "default": "胶片去色罩"
      },
      "minimumSize": {
        "width": 320,
        "height": 500
      },
      "maximumSize": {
        "width": 2000,
        "height": 2400
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 820
      },
      "preferredFloatingSize": {
        "width": 720,
        "height": 920
      }
    }
  ]
}
