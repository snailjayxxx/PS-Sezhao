  "id": "com.snailjoss.pssezhao",
  "name": "PS 去色罩",
  "version": "0.1.2",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.3.0"
  },
  "apiVersion": 2,
  "entrypoints": [
    {
      "type": "panel",
      "id": "sezhaoPanel",
